<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_office_asset_loan_own" model="ir.rule">
            <field name="name">Office Asset Loan: users see their own loans</field>
            <field name="model_id" ref="model_office_asset_loan"/>
            <field name="domain_force">[('borrower_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_office_asset_loan_all" model="ir.rule">
            <field name="name">Office Asset Loan: administrators see all loans</field>
            <field name="model_id" ref="model_office_asset_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>